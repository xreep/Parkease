# Leave unset in development (Vite proxies /api to localhost:8080).
# In production (Vercel) set it to the deployed backend, e.g. https://parkease-api.onrender.com/api/v1
# VITE_API_URL=https://your-backend.example.com/api/v1
# vercel.json's Content-Security-Policy allows API calls to https://*.onrender.com only: if the backend is served from
# another domain, add that origin to connect-src (and img-src, for locally stored uploads) in vercel.json.

# The site's public origin (no trailing slash), used for the absolute Open Graph / Twitter preview image URLs.
# Set it in Vercel to the production URL; unset, those URLs stay relative.
# VITE_PUBLIC_URL=https://parkease.example.com
