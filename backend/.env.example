# Copy to backend/.env (never commit .env). Uncomment and set only what you need; every value is optional in the dev profile.
# (Empty values would override the dev defaults, so unset keys are commented out.)
# Load with:  set -a && source .env && set +a && ./mvnw spring-boot:run

# --- Profile ---
SPRING_PROFILES_ACTIVE=dev

# --- Database (dev defaults to local smartparking_dev as your macOS user) ---
# Prod (Neon): DB_URL=jdbc:postgresql://<host>/<db>?sslmode=require
# DB_URL=
# DB_USERNAME=
# DB_PASSWORD=

# --- Security (REQUIRED in prod): base64 of at least 32 random bytes ---
# Generate: openssl rand -base64 48
# JWT_SECRET=

# --- URLs ---
# FRONTEND_URL=http://localhost:5173
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Email (leave MAIL_HOST empty to print emails to the console) ---
# Gmail: MAIL_HOST=smtp.gmail.com MAIL_PORT=587, MAIL_USERNAME=<you>@gmail.com, MAIL_PASSWORD=<16-char app password>
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM="ParkEase <no-reply@parkease.local>"

# --- Demo accounts password (dev profile only) ---
# DEMO_PASSWORD=Demo@1234

# --- Uploads (photos and owner documents) ---
# Local disk is the default. Set CLOUDINARY_URL to store files in Cloudinary instead.
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# Public base URL used to build links to locally stored files
# PUBLIC_BASE_URL=http://localhost:8080
# Directory for local uploads, relative to the backend folder
# STORAGE_LOCAL_DIR=uploads
