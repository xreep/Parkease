# Copy to backend/.env (never commit .env). Uncomment and set only what you need; every value is optional in the dev profile.
# (Empty values would override the dev defaults, so unset keys are commented out.)
# Local run:  set -a && source .env && set +a && ./mvnw spring-boot:run
# Hosted (Render): enter these in the dashboard instead; render.yaml lists the keys. See docs/DEPLOYMENT.md.

# --- Profile ---
# dev  = local development (demo data seeded, mock payments allowed)
# prod = hardened hosted deployment; refuses to start with an unsafe configuration
# prod,demo = production settings plus the demo accounts and sample data (needs DEMO_PASSWORD)
SPRING_PROFILES_ACTIVE=dev

# --- HTTP ---
# Port to listen on. Hosts such as Render set it for you; defaults to 8080.
# PORT=8080

# --- Proxy (prod) ---
# Tomcat trusts X-Forwarded-For only from "internal proxies": private, loopback, link-local and CGNAT addresses by default.
# If the host's proxy is outside those ranges, set a regular expression matching the whole peer address. Never `.*`.
# INTERNAL_PROXIES=10\.\d{1,3}\.\d{1,3}\.\d{1,3}

# --- Database (dev defaults to local smartparking_dev as your macOS user) ---
# REQUIRED in prod. Neon: copy host/db/user/password from the connection details and keep sslmode=require.
# Use Neon's DIRECT host (no "-pooler" in the name): Flyway's advisory locks break behind PgBouncer.
# DB_URL=jdbc:postgresql://<host>/<db>?sslmode=require
# DB_USERNAME=
# DB_PASSWORD=
# Tests only (the suite reads it; CI sets it): database used by ./mvnw test
# TEST_DB_URL=jdbc:postgresql://localhost:5432/smartparking_test

# --- Security ---
# REQUIRED in prod: base64 of at least 32 random bytes. The development secret is refused in prod.
# Generate: openssl rand -base64 48
# JWT_SECRET=

# --- URLs ---
# REQUIRED in prod: FRONTEND_URL must be the exact https origin of the frontend (no trailing slash).
# In prod, CORS allows only that origin unless CORS_ALLOWED_ORIGINS (comma separated, exact https origins) is set.
# FRONTEND_URL=http://localhost:5173
# CORS_ALLOWED_ORIGINS=http://localhost:5173
# This service's own public URL, used to build links to locally stored (non-Cloudinary) uploads
# PUBLIC_BASE_URL=http://localhost:8080

# --- Email (leave MAIL_HOST empty to print emails to the console) ---
# Optional in prod (a warning is logged when missing).
# Gmail: MAIL_HOST=smtp.gmail.com MAIL_PORT=587, MAIL_USERNAME=<you>@gmail.com, MAIL_PASSWORD=<16-char app password>
# Brevo: MAIL_HOST=smtp-relay.brevo.com MAIL_PORT=587 (2525 on Render's free plan), MAIL_USERNAME=<login>, MAIL_PASSWORD=<SMTP key>
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM="ParkEase <no-reply@parkease.local>"

# --- Demo accounts password ---
# dev profile: defaults to Demo@1234. The demo profile (prod,demo) has NO default and refuses to start without it.
# At least 8 characters with a letter and a digit.
# DEMO_PASSWORD=Demo@1234

# --- Uploads (photos and owner documents) ---
# Local disk is the default. Set CLOUDINARY_URL to store files in Cloudinary instead.
# Recommended in prod: Render's disk is ephemeral, so local uploads disappear on every restart (a warning is logged).
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# Directory for local uploads, relative to the backend folder
# STORAGE_LOCAL_DIR=uploads

# --- Payments (Razorpay) ---
# dev: leave these unset to use the built-in mock payment provider (no account needed).
# prod: RAZORPAY_KEY_ID and RAZORPAY_KEY_SECRET are REQUIRED (the mock provider is disabled in prod).
# For real checkout in TEST mode: Razorpay dashboard -> switch to Test mode -> Settings -> API keys.
# Test card 4111 1111 1111 1111 (any future expiry, any CVV); test UPI success@razorpay. Never commit real keys.
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
# RAZORPAY_KEY_SECRET=
# Webhook signing secret you choose when adding https://<backend>/api/v1/payments/webhook in the Razorpay dashboard
# RAZORPAY_WEBHOOK_SECRET=
# Mock payment endpoint (/payments/mock/pay); defaults to true in dev, forced off in prod
# PAYMENTS_MOCK_ENABLED=true

# --- JVM (Docker image only) ---
# Defaults to -XX:MaxRAMPercentage=75 -XX:+UseSerialGC -Xss512k -XX:+ExitOnOutOfMemoryError
# JAVA_OPTS=
